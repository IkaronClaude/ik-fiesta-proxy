# Copy to .env beside this file and fill in. Nothing here is committed: the XOR table and the game data
# paths are bring-your-own.

# The address the CLIENT should dial for the world manager and zone, as the client sees this machine.
# Not the container's view: with host networking the container shares this machine's addresses, but the
# endpoints handed to the client have to be reachable from wherever the client runs.
ADVERTISE_IP=172.25.164.128

# The C->S cipher table. Without it the bridge cannot read anything the client sends.
XOR_TABLE=C:/Projects/ik-fiesta-bots/xor-table.hex

# Opcodes the 2016 build defines, so the bridge can drop 2026-only frames instead of relaying them and
# having the server hang up. The same all-enums.json the protocol tooling uses.
OPCODES_JSON=C:/Projects/ik-fiesta-bots/lib/FiestaLib-Reloaded/docs/extracted/merged/all-enums.json

# 1 to log every frame. Verbose, but it is how every layout in the plugin was measured.
PACKET_LOG=0
