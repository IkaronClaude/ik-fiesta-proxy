# Copy to .env beside this file and fill in. Nothing here is committed.

# The address the CLIENT should dial for the world manager and zone, as the client sees this machine.
# Not the container's view: with host networking the container shares this machine's addresses, but the
# endpoints handed to the client have to be reachable from wherever the client runs.
ADVERTISE_IP=172.25.164.128

# 1 to log every frame. Server->client is plaintext; the client side is logged encrypted unless the XOR table is
# mounted (see the commented lines in docker-compose.yml).
PACKET_LOG=0
# XOR_TABLE=C:/path/to/xor-table.hex
